{
  "expo": {
    "name": "Ampara",
    "slug": "ampara-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/maos-ampara-rosa.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.amparaapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5EFE6",
        "foregroundImage": "./assets/images/maos-ampara-rosa.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.amparaapp"
    },
    "web": {
      "favicon": "./assets/images/maos-ampara-rosa.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/maos-ampara-rosa.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F5EFE6"
        }
      ],
      "expo-font"
    ]
  }
}
