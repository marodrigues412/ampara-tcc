{
  "expo": {
    "name": "Ampara",
    "slug": "ampara-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/maos-ampara-azul.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.amparaapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5EFE6",
        "foregroundImage": "./assets/images/maos-ampara-azul.png"
      },
      "package": "com.ampara",
      "permissions": [
        "android.permission.health.READ_HEART_RATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/maos-ampara-azul.png"
    },
    "plugins": [
      "./modules/ampara-watch/plugin",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/maos-ampara-azul.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F5EFE6"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "ac3e0f36-a2a6-45b7-8afa-1636f4c08d83"
      }
    },
    "owner": "amanda.herculano"
  }
}
