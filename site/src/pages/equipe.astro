---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = 'Equipe Ampara | Instituto Mauá de Tecnologia';
const description = 'Conheça a equipe de estudantes do Instituto Mauá de Tecnologia que desenvolve o Ampara.';
---
<SiteLayout title={title} description={description} current="equipe">
  <section class="team-hero"><div class="shell"><p class="eyebrow">Quem faz</p><h1 class="page-title">Uma ideia construída<br /><em>em conjunto.</em></h1><p class="lead">O Ampara é um Trabalho de Conclusão de Curso em Ciência da Computação no Instituto Mauá de Tecnologia.</p></div></section>
  <section class="people shell section-pad"><article class="person"><div class="portrait"><img src="/maria-site.webp" alt="Maria Eduarda, integrante da equipe Ampara" /></div><div class="person-info"><p class="eyebrow">Dados · Desenvolvimento · Produto</p><h2>Maria Eduarda</h2><p>Trabalha na construção do produto e na integração entre dados, experiência e tecnologia.</p><a class="linkedin-link" href="https://www.linkedin.com/in/marodrigu3s/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></div></article><article class="person"><div class="portrait"><img src="/amanda-site.webp" alt="Amanda Herculano, integrante da equipe Ampara" /></div><div class="person-info"><p class="eyebrow">Experiência · Arquitetura · Integrações</p><h2>Amanda Herculano</h2><p>Contribui com a arquitetura da solução, as integrações e a experiência de quem usa.</p><a class="linkedin-link" href="https://www.linkedin.com/in/amanda-herculano/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></div></article></section>
  <section class="institution"><div class="shell institution-inner"><div><p class="eyebrow">Instituição de ensino</p><h2>Instituto Mauá<br />de Tecnologia</h2><p>Pesquisa, engenharia e colaboração acadêmica a serviço de um desafio cotidiano.</p></div><div class="institution-logo"><img src="/imt-logo.png" alt="Logo oficial do Instituto Mauá de Tecnologia" /></div></div></section>
  <section class="events shell"><div><p class="eyebrow">Apresentação acadêmica</p><h2>Compartilhando o que estamos construindo.</h2></div><div class="event-cards"><article><span>EUREKA 2026</span><h3>Mostra de projetos</h3><p>23 e 24 de outubro · 12h às 22h · Stand 72</p></article><article><span>CONIC 2026</span><h3>Iniciação científica</h3><p>Trabalho submetido e aceito.<br />Data da apresentação divulgada em breve.</p></article></div></section>
  <section class="thanks shell" aria-labelledby="thanks-title"><p class="eyebrow">Com gratidão</p><h2 id="thanks-title">Este projeto também foi construído com a ajuda de muita gente.</h2><div class="thanks-groups"><div><b>Orientadores</b><p>Milkes Yone Alvarenga<br />Rodrigo Bossini Tavares Moreira</p></div><div><b>Professores que nos apoiaram</b><p>Ana Paula Goncalves Serra<br />Evandro Catelani Ferraz<br />Everaldo Pereira<br />Everson Denis<br />Sérgio Genciauskas</p></div><div><b>Coordenação | Professores de TCC</b><p>Rudolf Theoderich Buhler<br />Jhonny Frank Sousa Joca<br />Alexsander Tressino de Carvalho</p></div><div><b>Design</b><p>Giovana Pavanato<br />Pedro Henrique Carvalho<br />Tiago Perrella</p></div></div></section>
</SiteLayout>
<style>
  .team-hero{padding:72px 0 60px;background:#e9eff2}.team-hero .lead{max-width:590px}.people{display:grid;grid-template-columns:1fr 1fr;gap:18px}.person{display:flex;align-items:center;gap:22px;min-width:0;padding:22px;background:#fff;border:1px solid #eee5e6}.portrait{width:130px;height:170px;flex:none;display:flex;align-items:flex-end;justify-content:center;overflow:hidden}.person:first-child .portrait{width:180px}.portrait img{display:block;width:100%;height:100%;object-fit:contain;object-position:center bottom}.person-info{min-width:0}.person .eyebrow{font-size:9px;letter-spacing:.08em}.person h2{margin:0 0 8px;color:var(--navy);font-size:24px}.person-info>p:not(.eyebrow){margin:0;color:var(--muted);font-size:13px;line-height:1.6}.linkedin-link{display:inline-flex;align-items:center;gap:6px;margin-top:14px;color:var(--rose-dark);font-size:13px;font-weight:700;text-decoration:none}.linkedin-link:hover{text-decoration:underline}.institution{background:var(--navy);color:#fff}.institution-inner{min-height:300px;display:flex;align-items:center;justify-content:space-between;gap:36px}.institution .eyebrow{color:#f0b9cb}.institution h2{margin:0;font-size:40px;line-height:1.05}.institution p:last-child{max-width:460px;color:#dce2ef;font-size:14px;line-height:1.6}.institution-logo{width:250px;max-width:38%;padding:12px;background:#fff}.institution-logo img{display:block;width:100%;height:auto}.events{padding-block:74px;display:grid;grid-template-columns:.8fr 1.2fr;align-items:center;gap:5vw}.events h2{max-width:370px;margin:0;color:var(--navy);font-size:34px;line-height:1.12}.event-cards{display:grid;grid-template-columns:1fr 1fr;gap:14px}.event-cards article{min-height:150px;padding:22px;background:#fff;border:1px solid #eee5e6}.event-cards article span{color:var(--rose-dark);font-size:10px;font-weight:800;letter-spacing:.12em}.event-cards h3{margin:24px 0 6px;color:var(--navy);font-size:18px}.event-cards p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}
  .team-hero{padding:72px 0 60px;background:#e9eff2}.team-hero .lead{max-width:590px}.people{display:grid;grid-template-columns:1fr 1fr;gap:18px}.person{display:flex;align-items:center;gap:22px;min-width:0;padding:22px;background:#fff;border:1px solid #eee5e6}.portrait{width:150px;height:170px;flex:none;display:flex;align-items:flex-end;justify-content:center;overflow:hidden}.portrait img{display:block;width:100%;height:100%;object-fit:contain;object-position:center bottom}.person-info{min-width:0}.person .eyebrow{font-size:9px;letter-spacing:.08em}.person h2{margin:0 0 8px;color:var(--navy);font-size:24px}.person-info>p:not(.eyebrow){margin:0;color:var(--muted);font-size:13px;line-height:1.6}.linkedin-link{display:inline-flex;align-items:center;gap:6px;margin-top:14px;color:var(--rose-dark);font-size:13px;font-weight:700;text-decoration:none}.linkedin-link:hover{text-decoration:underline}.institution{background:var(--navy);color:#fff}.institution-inner{min-height:300px;display:flex;align-items:center;justify-content:space-between;gap:36px}.institution .eyebrow{color:#f0b9cb}.institution h2{margin:0;font-size:40px;line-height:1.05}.institution p:last-child{max-width:460px;color:#dce2ef;font-size:14px;line-height:1.6}.institution-logo{width:250px;max-width:38%;padding:12px;background:#fff}.institution-logo img{display:block;width:100%;height:auto}.events{padding-block:74px;display:grid;grid-template-columns:.8fr 1.2fr;align-items:center;gap:5vw}.events h2{max-width:370px;margin:0;color:var(--navy);font-size:34px;line-height:1.12}.event-cards{display:grid;grid-template-columns:1fr 1fr;gap:14px}.event-cards article{min-height:150px;padding:22px;background:#fff;border:1px solid #eee5e6}.event-cards article span{color:var(--rose-dark);font-size:10px;font-weight:800;letter-spacing:.12em}.event-cards h3{margin:24px 0 6px;color:var(--navy);font-size:18px}.event-cards p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}.thanks{padding-top:18px;padding-bottom:58px;border-top:1px solid #e5dce0}.thanks .eyebrow{margin-bottom:8px}.thanks h2{max-width:520px;margin:0 0 22px;color:var(--navy);font-size:20px;line-height:1.35}.thanks-groups{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.thanks-groups>div{min-width:0}.thanks-groups p{margin:6px 0 0;color:var(--muted);font-size:12px;line-height:1.65}.thanks-groups b{color:#555b69;font-size:11px}
  @media(max-width:760px){.team-hero{padding:54px 0 42px}.people{grid-template-columns:1fr}.person{align-items:center;gap:16px;padding:16px}.portrait{width:96px;height:122px}.person h2{font-size:20px}.person .eyebrow{max-width:190px;line-height:1.5}.institution-inner{min-height:0;padding-block:40px}.institution h2{font-size:34px}.institution-logo{width:155px;max-width:40%;padding:8px;flex:none}.events{padding-block:50px;grid-template-columns:1fr}.events h2{font-size:30px}.event-cards{grid-template-columns:1fr}.thanks{padding-top:8px;padding-bottom:42px}.thanks-groups{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}}
  .institution-logo{width:280px;padding:0;background:transparent}
  @media(max-width:760px){.institution-logo{width:170px;padding:0}}
</style>
