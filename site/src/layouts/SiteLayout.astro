---
const { title, description, current = 'inicio' } = Astro.props;
const links = [
  { id: 'inicio', label: 'Início', href: '/' },
  { id: 'app', label: 'O aplicativo', href: '/app/' },
  { id: 'projeto', label: 'O projeto', href: '/projeto/' },
  { id: 'equipe', label: 'Equipe', href: '/equipe/' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f4f1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://ampara.info${Astro.url.pathname}`} />
    <link rel="icon" href="/favicon-ampara.png?v=4" type="image/png" />
    <link rel="shortcut icon" href="/favicon-ampara.png?v=4" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Ampara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://ampara.info${Astro.url.pathname}`} />
    <meta property="og:image" content="https://ampara.info/share-ampara.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="event-strip"><a class="event-link" href="https://eureka.maua.br/" target="_blank" rel="noreferrer">Eureka 2026</a><p>23 e 24 de outubro <b>·</b> Stand 72</p><a href="/projeto/">Conheça o Ampara <span aria-hidden="true">→</span></a></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Ampara, início"><img src="/maos-ampara-azul-site.webp" alt="" /><span>Ampara</span></a>
      <nav class="tabs" aria-label="Navegação principal">
        {links.map((link) => <a href={link.href} class:list={{ active: current === link.id }} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>)}
      </nav>
      <div class="header-contact"><a class="header-link" href="https://www.instagram.com/amparainfo/" target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a><a class="header-link" href="mailto:amparainfo2026@gmail.com">E-mail</a></div>
    </header>
    <main id="conteudo"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top"><a class="brand" href="/"><img src="/maos-ampara-azul-site.webp" alt="" /><span>Ampara</span></a><p>Tecnologia que percebe.<br />Proteção que acompanha.</p><nav aria-label="Links institucionais"><a href="/app/">O aplicativo</a><a href="/projeto/">O projeto</a><a href="/equipe/">Equipe</a><a href="https://www.instagram.com/amparainfo/" target="_blank" rel="noreferrer">Instagram ↗</a><a href="mailto:amparainfo2026@gmail.com">E-mail</a></nav></div>
      <div class="footer-bottom"><span>Projeto acadêmico · Instituto Mauá de Tecnologia · 2026</span><span>Emergência: <a href="tel:190">190</a> · Central da Mulher: <a href="tel:180">180</a></span></div>
    </footer>
  </body>
</html>

<style is:global>
  :root{color-scheme:light;--navy:#273963;--navy-deep:#1d2c50;--rose:#bd5574;--rose-dark:#a84264;--pink:#f7e7ec;--blue:#5a829e;--green:#287861;--paper:#f8f4f1;--white:#fff;--ink:#2d2b33;--muted:#6e7180;--line:#e9dfe1;--max:1160px;font-family:Inter,"Avenir Next",Avenir,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  *,*::before,*::after{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);-webkit-font-smoothing:antialiased}a{color:inherit}.skip-link{position:absolute;top:-60px;left:12px;z-index:30;padding:12px 16px;color:#fff;background:var(--navy)}.skip-link:focus{top:12px}
  .event-strip{min-height:38px;padding:7px 5vw;display:flex;justify-content:center;align-items:center;gap:12px;background:var(--navy);color:#fff;font-size:12px}.event-strip>span{padding:4px 8px;background:var(--rose);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.event-strip p{margin:0;color:#e2e7f1}.event-strip a{margin-left:auto;text-decoration:none;font-weight:700}.site-header{position:relative;min-height:78px;padding:10px max(5vw,24px);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px;border-bottom:1px solid rgba(39,57,99,.1);background:rgba(248,244,241,.94);backdrop-filter:blur(14px)}.brand{display:inline-flex;align-items:center;gap:9px;width:max-content;color:var(--navy);text-decoration:none}.brand img{width:36px;height:34px;object-fit:contain}.brand span{font-size:24px;font-weight:760}.tabs{display:flex;align-items:center;justify-content:center;gap:4px;padding:4px;border:1px solid #e9dfe1;border-radius:999px;background:#fff}.tabs a{padding:10px 17px;border-radius:999px;color:#5f6070;text-decoration:none;font-size:13px;font-weight:650;white-space:nowrap;transition:background .2s,color .2s}.tabs a:hover{color:var(--rose-dark);background:#fbf2f5}.tabs a.active{background:var(--navy);color:#fff}.header-contact{justify-self:end;display:flex;align-items:center;gap:16px}.header-link{color:var(--rose-dark);font-size:13px;font-weight:700;text-decoration:none;white-space:nowrap}.header-link span{margin-left:5px}.site-footer{margin-top:72px;padding:38px max(5vw,24px) 20px;background:var(--navy);color:#fff}.footer-top,.footer-bottom{max-width:var(--max);margin:auto;display:flex;justify-content:space-between;align-items:center;gap:24px}.footer-top{padding-bottom:30px}.footer-top .brand{color:#fff}.footer-top p{margin:0;color:#e5e9f2;line-height:1.55}.footer-top nav{display:flex;gap:20px;flex-wrap:wrap}.footer-top nav a,.footer-bottom a{color:#fff;text-decoration:none}.footer-bottom{padding-top:18px;border-top:1px solid rgba(255,255,255,.18);color:#d5dbea;font-size:12px}
  .shell{width:min(var(--max),calc(100% - 64px));margin-inline:auto}.eyebrow{margin:0 0 16px;color:var(--rose-dark);font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.page-title{max-width:780px;margin:0;color:var(--navy);font-size:clamp(42px,6vw,76px);line-height:1.02;letter-spacing:-.035em}.page-title em{color:var(--rose);font-style:normal}.lead{max-width:620px;color:#5d6170;font-size:18px;line-height:1.65}.button{display:inline-flex;align-items:center;gap:12px;min-height:48px;padding:0 20px;text-decoration:none;font-size:14px;font-weight:750;transition:transform .2s,background .2s}.button:hover{transform:translateY(-2px)}.button-primary{background:var(--rose-dark);color:#fff}.button-secondary{border:1px solid #d8c7cf;color:var(--navy)}.section-pad{padding:84px 0}.section-heading{margin-bottom:36px}.section-heading h2,.page-heading h1{margin:0;color:var(--navy);font-size:clamp(32px,4vw,52px);line-height:1.08;letter-spacing:-.025em}.section-heading p{max-width:580px;color:var(--muted);font-size:16px;line-height:1.7}.tagline{font-family:Georgia,serif;font-style:italic;color:var(--rose-dark)}
  @media(max-width:760px){.event-strip{padding-inline:16px;gap:8px;font-size:10px}.event-strip a{font-size:10px}.site-header{grid-template-columns:1fr auto;gap:10px;padding:10px 18px}.brand img{width:30px;height:29px}.brand span{font-size:21px}.tabs{grid-column:1/-1;grid-row:2;justify-content:space-between;width:100%;overflow-x:auto;border-radius:3px;padding:3px}.tabs a{flex:1;text-align:center;padding:10px 8px;font-size:12px}.header-contact{gap:10px}.header-link{font-size:11px}.shell{width:calc(100% - 36px)}.section-pad{padding:58px 0}.footer-top,.footer-bottom{align-items:flex-start;flex-direction:column}.footer-top nav{gap:16px}.footer-bottom{font-size:11px}}
  .site-footer{margin-top:0}.site-footer .brand img{filter:brightness(0) invert(1)}
  .event-strip .event-link{margin-left:0;padding:4px 8px;background:var(--rose);color:#fff;text-decoration:none;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.event-strip .event-link:hover{background:var(--rose-dark)}
</style>
